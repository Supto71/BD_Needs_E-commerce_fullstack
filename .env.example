# ==========================================
# BDNEEDS LOCAL / CPANEL CONFIG
# ==========================================

# 1. DATABASE_URL
# - For Local MySQL (XAMPP / Laragon / MySQL Server):
# DATABASE_URL="mysql://root:@localhost:3306/bdneeds"
#
# - For Remote cPanel MySQL (from your PC):
# DATABASE_URL="mysql://cpaneluser_dbuser:password@YOUR_DOMAIN_OR_SERVER_IP:3306/cpaneluser_bdneeds"
#
# - For Live cPanel Server:
# DATABASE_URL="mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_bdneeds"
DATABASE_URL=""
# 2. NEXTAUTH
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NODE_ENV="development"
PORT=3000

# 3. UDDOKTAPAY
UDDOKTAPAY_API_KEY="YOUR_PRODUCTION_API_KEY"
UDDOKTAPAY_BASE_URL="YOUR_PRODUCTION_UDDOKTAPAY_DOMAIN"

# 4. SMTP CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_SECURE="false"
